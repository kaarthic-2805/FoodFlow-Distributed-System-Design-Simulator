FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/web-app/package*.json ./apps/web-app/
RUN npm install
COPY packages/shared ./packages/shared
COPY apps/web-app ./apps/web-app
RUN npm run build --workspace=@foodflow/shared
RUN npm run build --workspace=@foodflow/web-app
EXPOSE 3000
CMD ["npm", "run", "preview", "--workspace=@foodflow/web-app", "--", "--host", "0.0.0.0", "--port", "3000"]
