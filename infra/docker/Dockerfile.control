FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/database/package*.json ./packages/database/
COPY apps/control-service/package*.json ./apps/control-service/
RUN npm install
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY apps/control-service ./apps/control-service
RUN npm run db:generate --workspace=@foodflow/database
RUN npm run build --workspace=@foodflow/shared
RUN npm run build --workspace=@foodflow/database
RUN npm run build --workspace=@foodflow/control-service
EXPOSE 4010
CMD ["npm", "run", "start", "--workspace=@foodflow/control-service"]
