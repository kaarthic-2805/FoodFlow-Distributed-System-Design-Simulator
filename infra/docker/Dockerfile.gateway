FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/api-gateway/package*.json ./apps/api-gateway/
RUN npm install
COPY packages/shared ./packages/shared
COPY apps/api-gateway ./apps/api-gateway
RUN npm run build --workspace=@foodflow/shared
RUN npm run build --workspace=@foodflow/api-gateway
EXPOSE 4000
CMD ["npm", "run", "start", "--workspace=@foodflow/api-gateway"]
