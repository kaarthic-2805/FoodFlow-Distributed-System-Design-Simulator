FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/database/package*.json ./packages/database/
COPY apps/restaurant-service/package*.json ./apps/restaurant-service/
RUN npm install
COPY packages/shared ./packages/shared
COPY packages/database ./packages/database
COPY apps/restaurant-service ./apps/restaurant-service
RUN npm run db:generate --workspace=@foodflow/database
RUN npm run build --workspace=@foodflow/shared
RUN npm run build --workspace=@foodflow/database
RUN npm run build --workspace=@foodflow/restaurant-service
CMD ["npm", "run", "start", "--workspace=@foodflow/restaurant-service"]
