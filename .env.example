# FoodFlow Configuration

# Database (SQLite File - No Docker required)
DATABASE_URL="file:./dev.db"

# Cloud-Hosted Kafka (Upstash / Confluent Cloud / Aiven)
# Leave Username empty to run locally or on fallback engine
KAFKA_BROKERS="localhost:9094"
KAFKA_SSL="false"
KAFKA_SASL_MECHANISM="scram-sha-256"
KAFKA_SASL_USERNAME=""
KAFKA_SASL_PASSWORD=""

# Redis (Falls back to In-Memory Cache if Redis is absent)
REDIS_URL="redis://localhost:6379"

# Service Ports
PORT_GATEWAY=4000
PORT_RESTAURANT_1=4001
PORT_RESTAURANT_2=4002
PORT_USER=4003
PORT_ORDER_1=4004
PORT_ORDER_2=4005
PORT_CONTROL=4010
PORT_WEB=3000

# Secret Key
JWT_SECRET="foodflow-super-secret-jwt-key"
